{
  "inputs": [
    {
      "id": "ado_org",
      "type": "promptString",
      "description": "Azure DevOps organization slug (the name after dev.azure.com/)"
    },
    {
      "id": "salesforce_org",
      "type": "promptString",
      "description": "One Salesforce CLI alias already authenticated on this machine (not a username)"
    }
  ],
  "servers": {
    "ado": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@azure-devops/mcp@2.10.0",
        "${input:ado_org}",
        "-d",
        "work-items",
        "wiki",
        "search"
      ]
    },
    "salesforce": {
      "type": "stdio",
      "command": "node",
      "cwd": "${workspaceFolder}",
      "args": [
        "scripts/start_salesforce_mcp.mjs",
        "--mode",
        "review",
        "--org",
        "${input:salesforce_org}"
      ]
    }
  }
}
